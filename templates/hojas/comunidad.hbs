<div class="er-cuerpo er-cuerpo-secundaria">
  <header class="er-cabecera">
    <img class="er-cabecera-img" src="{{actor.img}}" alt="" data-edit="img"
         data-action="{{#if editando}}editImage{{else}}showPortraitArtwork{{/if}}">
    <div class="er-cabecera-datos">
      {{#if editando}}<input class="er-titulo-input" type="text" name="name" value="{{actor.name}}" placeholder="Nombre de la comunidad">
      {{else}}<h1>{{actor.name}}</h1>{{/if}}
      <label class="er-campo">Tipo de comunidad
        <select name="system.tipo" {{disabled (not editable)}}>{{selectOptions tipos selected=system.tipo blank="— Tipo —"}}</select>
      </label>
      {{#if tipo}}<p class="er-linea er-tenue">{{tipo.texto}}</p>{{/if}}
    </div>
    <div class="er-herramientas er-herramientas-fijas">
      {{#if editable}}
      <button type="button" data-action="editar" class="{{#if editando}}activo{{/if}}" data-tooltip="{{#if editando}}Bloquear{{else}}Desbloquear imagen y nombre{{/if}}">
        <i class="fa-solid {{#if editando}}fa-lock-open{{else}}fa-lock{{/if}}"></i></button>
      {{/if}}
    </div>
  </header>

  <main class="er-principal">
    <p class="er-intro">Toda comunidad se define por cuatro cosas. <small>V 18 · R 6</small></p>
    <div class="er-cuatro">
      {{#each preguntas}}
      <article class="er-tarjeta er-pregunta-comunidad er-{{clave}}">
        <h4>{{titulo}}</h4>
        <textarea name="system.{{clave}}" rows="3" {{disabled (not @root.editable)}}>{{valor}}</textarea>
        {{#if (and @root.editable sugerencias.length)}}
        <div class="er-chips">
          {{#each sugerencias}}<button type="button" class="er-chip" data-action="sugerencia" data-clave="{{../clave}}" data-texto="{{this}}">{{this}}</button>{{/each}}
        </div>
        {{/if}}
      </article>
      {{/each}}
    </div>

    <details class="er-bloque" data-memoria="diario" {{#if secciones.diario}}open{{/if}}>
      <summary><h3 class="er-cinta">Notas</h3></summary>
      {{#if editable}}<prose-mirror name="system.notas" value="{{system.notas}}" toggled>{{{notas}}}</prose-mirror>
      {{else}}<div class="er-notas">{{{notas}}}</div>{{/if}}
    </details>
  </main>
</div>
